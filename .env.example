# food_cost database on the Persimmon shared Postgres.
# The host is the Coolify container name on the internal Docker network; from a
# laptop, tunnel first (`infra db tunnel`) and point at localhost.
DATABASE_URL=postgresql://food_cost:PASSWORD@xympdicj5dge3ziq7f5lpzrr:5432/food_cost

# Where to pull source rows from. Both are read-only surfaces.
FINANCE_API_URL=https://renatodap.me/dap-finance
FITNESS_API_URL=https://renatodap.me/dap-fitness

# Must equal FOOD_COST_INTERNAL_SECRET set on dap-finance and dap-fitness.
# Deliberately separate from those apps' MCP_INTERNAL_SECRET: this one only reads.
FOOD_COST_INTERNAL_SECRET=

# Password gate for the UI (single-user app).
APP_PASSWORD=
AUTH_SECRET=

# Guards POST /api/cron/sync.
CRON_SECRET=
